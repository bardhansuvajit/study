   "source": [
    "student = {\n",
    "    'name': 'Suvajit',\n",
    "    'age': 30,\n",
    "    'isStudent': False\n",
    "}\n",
    "for key in student.keys():\n",
    "    print(key)\n",
    "for value in student.values():\n",
    "    print(value)\n",
    "for key, value in student.items():\n",
    "    print(f\"{key}: {value}\")"
